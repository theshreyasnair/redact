WALLET_ADDRESS=       # platform wallet that receives x402 USDC payments
PRIVATE_KEY=          # backend signing key — must match the recorder address on the contract
CONTRACT_ADDRESS=0xf88Fc7df9C728A306097d1dDA85325A97162c90d
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org  # public RPC; rate-limited. For production use a dedicated endpoint (Alchemy or QuickNode free tier).
FACILITATOR_URL=https://x402.org/facilitator
PORT=4021
CONTENT_KEY_DEV=       # local-dev only: any long random string. Ignored inside a TEE (dstack derives the key).
ANTHROPIC_API_KEY=     # arbitrator key for the in-enclave dispute resolver. Unset disables the resolver.
CONTRACT_DEPLOY_BLOCK=46662346  # first block where the contract has code; the resolver starts scanning here on first run
